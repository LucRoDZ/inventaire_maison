# Copy to .env and fill in. Never commit .env.

# Public domain served by Caddy (use "localhost" for local runs).
APP_DOMAIN=localhost

# PostgreSQL. Use a long random password made of hexadecimal characters only (openssl rand -hex 24):
# it is inserted as is in the connection URL.
POSTGRES_PASSWORD=change-me
# Used by the API when run outside Docker (npm run dev). Docker Compose builds its own URL.
DATABASE_URL=postgres://inventaire:change-me@localhost:5432/inventaire

# At least 32 characters (openssl rand -hex 32).
SESSION_SECRET=change-me-change-me-change-me-change-me

# Shared with the reverse proxy (X-Proxy-Secret header), 16 characters or more. Without it the API
# ignores X-Forwarded-For. Caddy gets it from here; for the shared nginx, put the same value in
# /opt/proxy/conf.d/inventaire.conf. Generate: openssl rand -hex 32
PROXY_SECRET=change-me-change-me

# First admin, created when the users table is empty. Password: at least 8 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Sent to Open Food Facts on every call. Use an app name and a contact address.
OFF_USER_AGENT=InventaireMaison/1.0 (contact: you@example.com)

# Compose files and profiles.
#   Local or fresh VPS (embedded Caddy):  COMPOSE_FILE=docker-compose.yml  COMPOSE_PROFILES=proxy
#   Behind the shared nginx of the VPS:   COMPOSE_FILE=docker-compose.yml:docker-compose.shared-proxy.yml  (no profile)
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=proxy

# External Docker network of the shared nginx (only with docker-compose.shared-proxy.yml).
SHARED_PROXY_NETWORK=
